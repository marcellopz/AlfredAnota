# Variáveis de ambiente de todo o projeto, para desenvolvimento.
# Copie este arquivo para .env (na raiz) e preencha. O .env nunca vai para o git.
#
# Quem lê este arquivo:
#   - bot (apps/bot): todas as variáveis, via `tsx --env-file`.
#   - função de lembretes (supabase/functions): via `supabase functions serve --env-file .env`.
#   - site (apps/web): SOMENTE as variáveis NEXT_PUBLIC_*. O next.config descarta o resto,
#     para que a chave secreta do banco nunca chegue ao site.
#
# Em produção este arquivo não é usado:
#   - site: variáveis cadastradas no painel da Vercel;
#   - função de lembretes: `pnpm supabase secrets set NOME=valor`;
#   - bot: .env próprio na máquina onde rodar, com o token do bot de produção.
#
# Um valor no formato ${NOME} copia outra variável deste arquivo.

# ---------------------------------------------------------------------------
# Telegram (a partir da Fase 0)
# ---------------------------------------------------------------------------

# Token do bot, obtido no @BotFather com /newbot. SEGREDO.
# Usado pelo bot (receber mensagens) e pela função de lembretes (enviar).
# Em desenvolvimento, use sempre o token do bot de DEV, nunca o de produção.
# Só pode haver uma instância do bot rodando por token (duas geram erro 409).
TELEGRAM_BOT_TOKEN=

# Nome de usuário do bot, sem o @ (ex: alfred_dev_bot).
# Usado para montar links t.me/<usuario>.
TELEGRAM_BOT_USERNAME=

# ---------------------------------------------------------------------------
# Supabase (a partir da Fase 0)
# ---------------------------------------------------------------------------

# URL da API do Supabase. Em desenvolvimento, o Supabase local (pnpm db:start).
# Em produção, https://<projeto>.supabase.co
SUPABASE_URL=http://127.0.0.1:54321

# Chave service_role (ou "secret key", sb_secret_...). SEGREDO.
# Ignora a RLS: por isso todo acesso ao banco no bot filtra por user_id.
# Local: valor de "service_role key" / "Secret" em `pnpm supabase status`.
# Nunca pode ser lida pelo site nem por código que roda no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Chave pública anon (ou "publishable key", sb_publishable_...).
# Pode ser exposta: os dados são protegidos pela RLS e pela sessão do usuário.
# Local: valor de "anon key" / "Publishable" em `pnpm supabase status`.
SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Site (a partir da Fase 1)
# ---------------------------------------------------------------------------

# Endereço do site, sem barra no final. Usado pelo bot nas mensagens de conexão
# ("Acesse <WEB_APP_URL>/conectar") e pelo site como destino do link de login por e-mail.
# Precisa estar em site_url / additional_redirect_urls do supabase/config.toml.
WEB_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Ollama / LLM (a partir da Fase 2)
# ---------------------------------------------------------------------------

# Endereço do Ollama rodando na máquina local.
OLLAMA_BASE_URL=http://localhost:11434

# Modelo usado para interpretar as mensagens. Escolhido na Fase 2
# comparando a taxa de acerto no `pnpm eval` (ex: qwen2.5:7b).
# O modelo precisa estar baixado: `ollama pull <modelo>`.
OLLAMA_MODEL=

# Tempo máximo de espera por resposta do Ollama, em milissegundos.
# Passado esse tempo, o usuário recebe um aviso e o erro é registrado.
OLLAMA_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Lembretes (a partir da Fase 3)
# ---------------------------------------------------------------------------

# Segredo que o agendador (pg_cron) envia no header x-cron-secret para chamar
# a função de lembretes. SEGREDO. Gere um valor aleatório longo, por exemplo no PowerShell:
#   $b = New-Object byte[] 32
#   [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b)
#   [Convert]::ToBase64String($b)
# O mesmo valor deve ser gravado no Supabase Vault com o nome cron_secret.
# (SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY são injetadas automaticamente nas Edge Functions.)
CRON_SECRET=

# ---------------------------------------------------------------------------
# Variáveis públicas do site (a partir da Fase 1)
# ---------------------------------------------------------------------------
# Tudo que começa com NEXT_PUBLIC_ fica visível no navegador. Só valores públicos aqui.
# Normalmente não é preciso alterar: elas copiam os valores acima.

NEXT_PUBLIC_SUPABASE_URL=${SUPABASE_URL}
NEXT_PUBLIC_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}
NEXT_PUBLIC_SITE_URL=${WEB_APP_URL}
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=${TELEGRAM_BOT_USERNAME}
